# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in real values. The ".env" file is
# gitignored and must NEVER be committed.
#
# This project is READ-ONLY. The only secret it needs is a Discord webhook URL
# to post alerts. It holds no wallet keys and places no trades.
# ---------------------------------------------------------------------------

# Discord Incoming Webhook URL. Create one under:
#   Server Settings -> Integrations -> Webhooks -> New Webhook -> Copy URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/XXXXXXXX/YYYYYYYY

# Optional: a SECOND webhook dedicated to error/health alerts. If unset, errors
# are sent to DISCORD_WEBHOOK_URL.
# DISCORD_ERROR_WEBHOOK_URL=
